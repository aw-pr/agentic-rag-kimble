#!/usr/bin/env bash
# Publish guard — pre-push. Fail-closed gate for a public mirror.
#
# CANONICAL SOURCE: mcp-hub/templates/git-hooks/pre-push.
# Do NOT edit the per-repo copy under scripts/git-hooks/ — edit this template
# and re-sync (mcp-hub/scripts/sync-all-platforms.sh), then re-arm each repo
# with scripts/install-guards.sh.
#
# Per-repo config (git config, local, never committed — keeps org/repo names
# out of the tracked tree):
#   publishguard.publicmatch   Identifies the PUBLIC remote (e.g.
#                              "myorg/myrepo"). Matched case-insensitively as a
#                              substring of the push URL, both normalised (see
#                              normalise_remote). Unset -> this hook is inert.
#   publishguard.sentinel      Env var the sanctioned publish path sets to 1.
#                              Default: PUBLISH_GUARD_OK
#   publishguard.historymode   preserve (default) | squash. Informational here;
#                              affects merge style upstream, surfaced in errors.
#   publishguard.privatefile   (repeatable) path that must NEVER reach the
#                              public tree. Default: HANDOFF.md
#   publishguard.publishbranch Local branch that ff's onto public default.
#                              Default: publish. Used here only as the default
#                              source for publishguard.prsource below.
#   publishguard.prsource      Branch allowed on the PUBLIC remote as a PR
#                              source (publish → main PR-for-publish flow).
#                              Default: value of publishguard.publishbranch.
#   publishguard.boundary      pr (default) | direct. In pr mode the public
#                              default branch may not be pushed at all: it
#                              advances only by a merge performed on the forge,
#                              where the diff is visible first. Push the
#                              prsource branch and open a PR instead. direct
#                              mode keeps the sentinel-only gate for repos that
#                              opt out.
#
# On the public remote: deleting the default branch (main/master) is always
# refused, whatever the sentinel or boundary. Only the default branch may be pushed,
# AND that push must arrive via the sanctioned path (sentinel env set) — i.e.
# `git publish`, which backs up to the private remote first. A direct
# `git push <public> dev:main` is blocked so it cannot skip that backup.
# Non-fast-forward pushes to the public default branch are rejected even with
# the sentinel set ("PUB/main is immutable"). A push is rejected when the
# pushed tip's tree contains a private file, or when any commit the push adds
# to the remote has one in its tree, so a private file added and later removed
# cannot reach public history. A commit the remote already holds (its old sha,
# or anything under this remote's tracking refs) is not judged again, and a
# commit that only deletes a private file passes. A remote sha this repo does
# not have never shrinks the scan: fetch the remote first if the history it
# would otherwise exclude is already public.
#
# The PR-source branch (publishguard.prsource) is also allowed on the public
# remote — this is the "publish-pr" fast-forward-free path: push `publish` as
# a non-default branch, then open a PR publish→main and review the diff before
# merging on GitHub. It does NOT require the sentinel (it isn't the sanctioned
# main-publish path — the PR review is the safeguard there) and is not subject
# to the ff-only check (it's an ordinary branch, not the immutable public
# default). It STILL runs the private-file scan of the tip and of every pushed
# commit: a privatefile leak on the PR source must be rejected exactly like on
# main, fail-closed. Any other
# non-default ref is still rejected.
# Optional chain point: scripts/publish-guard-strict-scan.sh (runs if present).
# Deliberate one-off override: git push --no-verify
remote_name="$1"
remote_url="$2"

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"

# Strict scanner — runs on every push, regardless of remote, if the repo ships
# one. Catches personal positioning phrases before any push leaves the laptop.
if [ -n "$repo_root" ] && [ -x "$repo_root/scripts/publish-guard-strict-scan.sh" ]; then
  "$repo_root/scripts/publish-guard-strict-scan.sh" || exit $?
fi

# Normalised spelling of a remote URL or of publishguard.publicmatch, so one
# repository matches however its URL is written: lowercase; scheme, user@,
# trailing / and trailing .git dropped; scp-style host:path read as host/path.
# Kept identical in templates/git-hooks/pre-push and scripts/git-push-check.
normalise_remote() {
  local u
  u="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  u="${u#*://}"
  case "${u%%/*}" in *@*) u="${u#*@}" ;; esac
  case "$u" in *:*) u="${u%%:*}/${u#*:}" ;; esac
  u="${u%/}"; u="${u%.git}"; u="${u%/}"
  printf '%s' "$u"
}

pub_match="$(git config --get publishguard.publicmatch || true)"
[ -z "$pub_match" ] && exit 0                 # not configured -> nothing to guard
case "$(normalise_remote "$remote_url")" in
  *"$(normalise_remote "$pub_match")"*) : ;;   # public — restricted below
  *) exit 0 ;;                                 # private/backup — allow everything
esac

sentinel="$(git config --get publishguard.sentinel || true)"
[ -z "$sentinel" ] && sentinel="PUBLISH_GUARD_OK"
history_mode="$(git config --get publishguard.historymode || true)"
[ -z "$history_mode" ] && history_mode="preserve"

# Private files that must never reach the public tree (repeatable git config).
private_files="$(git config --get-all publishguard.privatefile || true)"
[ -z "$private_files" ] && private_files="HANDOFF.md"
private_specs=()
while IFS= read -r pf; do
  [ -n "$pf" ] && private_specs+=("${pf%/}")
done <<< "$private_files"

# PR-source branch for the publish-pr flow. Defaults to publishbranch (empty
# publishbranch -> empty pr_source -> the case pattern below matches nothing,
# so the PR path stays disabled rather than silently matching an odd ref).
pr_source="$(git config --get publishguard.prsource || true)"
if [ -z "$pr_source" ]; then
  pr_source="$(git config --get publishguard.publishbranch || true)"
fi

# Zero SHA = ref deletion or initial push. Bash 3.2-compatible (no associative).
zero="0000000000000000000000000000000000000000"

# Reject the push if the tree being pushed contains a private file. Shared by
# both the main-publish path and the PR-source path — fail-closed on both.
check_privatefile() {
  sha="$1"
  ref="$2"
  [ "$sha" = "$zero" ] && return 0
  if ! git cat-file -e "${sha}^{tree}" 2>/dev/null; then
    echo "pre-push: cannot read the tree pushed to PUBLIC '$ref' — blocked." >&2
    return 1
  fi
  while IFS= read -r pf; do
    [ -z "$pf" ] && continue
    if ! private_matches="$(git --literal-pathspecs ls-tree -r --name-only "$sha" -- "${pf%/}" 2>/dev/null)"; then
      echo "pre-push: cannot check private path '$pf' — blocked." >&2
      return 1
    fi
    if [ -n "$private_matches" ]; then
      echo "pre-push: private file '$pf' present in the tree pushed to" >&2
      echo "          PUBLIC '$ref' — blocked. It is dev-only; keep it" >&2
      echo "          out of the publish tree. Deliberate override: --no-verify." >&2
      return 1
    fi
  done <<< "$private_files"
  return 0
}

# Reject the push if any commit it adds to the remote carries a private path in
# its tree. Added means reachable from the pushed sha and from neither the
# remote's old sha (when that is a commit here) nor any of this remote's
# tracking refs. A new ref, or an old sha this repo lacks, only drops out of
# the exclusions; it never shrinks the scan. Each commit's whole tree is
# judged rather than the paths it touches, so a commit that only deletes a
# private file passes. Any git failure here blocks.
check_pushed_commits() {
  sha="$1"
  old="$2"
  ref="$3"
  [ "$sha" = "$zero" ] && return 0
  [ "${#private_specs[@]}" -eq 0 ] && return 0
  exclude=()
  if [ "$old" != "$zero" ] && git cat-file -e "${old}^{commit}" 2>/dev/null; then
    exclude+=("$old")
  fi
  [ -n "$remote_name" ] && exclude+=("--remotes=$remote_name")
  if ! pushed="$(git rev-list "$sha" --not "${exclude[@]}" 2>/dev/null)"; then
    echo "pre-push: cannot list the commits pushed to PUBLIC '$ref' — blocked." >&2
    return 1
  fi
  while IFS= read -r c; do
    [ -z "$c" ] && continue
    if ! found="$(git -c core.quotePath=false --literal-pathspecs ls-tree -r --name-only "$c" -- "${private_specs[@]}" 2>/dev/null)"; then
      echo "pre-push: cannot read commit $c pushed to PUBLIC '$ref' — blocked." >&2
      return 1
    fi
    if [ -n "$found" ]; then
      echo "pre-push: private path(s) in commit $(git log -1 --format='%h %s' "$c" 2>/dev/null || echo "$c")," >&2
      echo "          which this push adds to PUBLIC '$ref' — blocked:" >&2
      printf '%s\n' "$found" | sed 's/^/            /' >&2
      echo "          A private file must not enter public history, even if a" >&2
      echo "          later commit removes it. If that history is already public," >&2
      echo "          fetch the remote first (git fetch $remote_name) so it is not" >&2
      echo "          judged again. Deliberate override: --no-verify." >&2
      return 1
    fi
  done <<< "$pushed"
  return 0
}

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    "")
      : ;;
    refs/heads/main|refs/heads/master)
      if [ "$local_sha" = "$zero" ]; then
        echo "pre-push: deleting '$remote_ref' on PUBLIC remote '$remote_name' blocked." >&2
        echo "          The public default branch is never deleted by a push." >&2
        exit 1
      fi
      if [ "${!sentinel:-}" != "1" ]; then
        echo "pre-push: direct publish to PUBLIC remote '$remote_name' blocked." >&2
        echo "          Run 'git publish' — it backs up to the private remote" >&2
        echo "          first, then publishes. Deliberate override: --no-verify." >&2
        exit 1
      fi
      # PR-for-publish boundary (default). The public default branch advances
      # by a merge performed on the forge, never by this push.
      #
      # There is deliberately no environment-variable escape hatch. The old
      # PUBLISH_PR_REVIEWED flag was an assertion by whoever was pushing, not a
      # check on anything, and the recipe printed below used to end with it: so
      # a PR was opened and completed by ff push seconds later, which makes the
      # forge stamp it merged without a diff ever being read. Five consecutive
      # publishes went out that way, each PR created and closed 11-17s apart
      # with zero reviews. A gate that the gated party can open is not a gate.
      boundary="$(git config --get publishguard.boundary || true)"
      [ -z "$boundary" ] && boundary="pr"
      if [ "$boundary" = "pr" ]; then
        echo "pre-push: publish boundary is PR-by-default — the PUBLIC default" >&2
        echo "          branch advances by a reviewed merge, not by this push:" >&2
        echo "            1. git push $remote_name ${pr_source:-publish}   (PR source, scanned)" >&2
        echo "            2. gh pr create --base ${remote_ref#refs/heads/} --head ${pr_source:-publish}" >&2
        echo "            3. read the diff on the forge and merge it there." >&2
        echo "          Protect the public default branch too, so the forge" >&2
        echo "          rejects a direct push even if this hook is missing." >&2
        echo "          Repo-level opt-out: git config publishguard.boundary direct" >&2
        exit 1
      fi
      # Block non-fast-forward to public default branch even with the sentinel.
      # Enforces "PUB/main is immutable" (critical in historymode=preserve;
      # always-true in squash where publish is append-only anyway).
      if [ "$remote_sha" != "$zero" ] && [ "$local_sha" != "$zero" ]; then
        if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
          echo "pre-push: non-fast-forward push to PUBLIC '$remote_ref' blocked." >&2
          echo "          history mode = ${history_mode}. PUB/main is immutable —" >&2
          echo "          published commits must not be rewritten. If this is a" >&2
          echo "          deliberate incident-grade history rewrite, override with" >&2
          echo "          --no-verify and confirm with the user first." >&2
          exit 1
        fi
      fi
      # Private files must not exist in the tree being published.
      check_privatefile "$local_sha" "$remote_ref" || exit 1
      check_pushed_commits "$local_sha" "$remote_sha" "$remote_ref" || exit 1
      ;;
    refs/heads/"$pr_source")
      # PR-for-publish source path: `publish` (or configured prsource) pushed
      # as a non-default branch, then `gh pr create publish->main` for review.
      # No sentinel required — this isn't the sanctioned main-publish path,
      # the PR review is the safeguard here. No ff-only check — this is an
      # ordinary branch, not the immutable public default. The private-file
      # scans still run, fail-closed, same as the main-publish path.
      check_privatefile "$local_sha" "$remote_ref" || exit 1
      check_pushed_commits "$local_sha" "$remote_sha" "$remote_ref" || exit 1
      ;;
    *)
      echo "pre-push: '$remote_ref' blocked on PUBLIC remote '$remote_name'." >&2
      echo "          Only the default branch is public. Override: --no-verify." >&2
      exit 1 ;;
  esac
done
exit 0
